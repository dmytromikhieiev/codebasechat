# Скопируй в .env и заполни реальными значениями. .env в git не коммитится.

# --- GitHub App ---
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
GITHUB_APP_WEBHOOK_SECRET=change_me
GITHUB_APP_SLUG=your-app-slug
# OAuth (user-to-server) — отдельные креды от JWT-ключа выше, из настроек GitHub App
GITHUB_APP_CLIENT_ID=Iv1.change_me
GITHUB_APP_CLIENT_SECRET=change_me

# --- Сессии пользователей ---
# Подпись stateless JWT (сессия + install-state), см. api/services/auth.py
SESSION_SECRET_KEY=change_me

# --- Фронтенд ---
# Куда редиректить браузер после /api/v1/auth/callback и /api/v1/github/callback
FRONTEND_URL=http://localhost:3000

# --- LLM (генерация ответа) ---
# ANSWER_PROVIDER=openai|anthropic, по умолчанию openai. ANSWER_MODEL
# опционален — если не задан, берётся дефолт для выбранного провайдера
# (см. DEFAULT_MODELS в api/services/answer.py). Нужен только ключ
# активного провайдера, второй можно не заполнять.
ANSWER_PROVIDER=openai
ANSWER_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Эмбеддинги и реранкинг ---
# EMBEDDING_PROVIDER=voyage|openai, по умолчанию voyage. EMBEDDING_MODEL
# опционален (см. DEFAULT_MODELS в api/services/embeddings.py). ВАЖНО:
# смена провайдера на уже проиндексированном репозитории требует полного
# реиндекса — векторы старого и нового провайдера несовместимы, даже
# несмотря на одинаковую размерность (см. комментарий в embeddings.py).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-code-3
# RERANK_PROVIDER=voyage|openai, по умолчанию voyage. RERANK_MODEL
# опционален — если не задан, берётся дефолт для выбранного провайдера
# (см. DEFAULT_MODELS в api/services/reranker.py). OpenAI не имеет
# отдельного rerank-эндпоинта — релевантность оценивает чат-модель.
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2
VOYAGE_API_KEY=pa-...

# --- Секреты (в проде — Vault, локально можно так) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token

# --- Инфраструктура (в docker-compose переопределяются автоматически) ---
# Порт 5433 — чтобы не конфликтовать с локальным Postgres на стандартном 5432
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# --- Приложение ---
APP_ENV=local
LOG_LEVEL=info
