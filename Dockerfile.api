FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
# worker/ is only needed here so `docker compose exec api pytest` can also
# collect worker/test_*.py — the api service never imports/runs it itself.
COPY worker ./worker
# alembic.ini + alembic/ are needed here too — the one-shot `migrate`
# service (docker-compose.yml) reuses this same image, just with a
# different command.
COPY alembic.ini .
COPY alembic ./alembic
COPY pytest.ini conftest.py .

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
